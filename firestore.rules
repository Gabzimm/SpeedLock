rules_version = '2';

// Quase tudo neste projeto passa por Cloud Functions (que usam o Admin
// SDK e por isso ignoram estas regras) — é aí que a decisão de acesso
// real acontece. As únicas leituras feitas diretamente pela app são as
// cobertas abaixo. Tudo o resto fica bloqueado por omissão de propósito:
// se um dia a app passar a ler mais alguma coisa direto do Firestore,
// isso deve ser uma decisão explícita, não um "esquecimento" destas
// regras a permitir por acidente.
service cloud.firestore {
  match /databases/{database}/documents {

    // lib/services/profile_service.dart -> watchOwnProfileDoc()
    // Cada um só lê o seu próprio documento de perfil. Escrita é sempre
    // via updateProfile (Cloud Function), nunca direto — é lá que a
    // bio/cores são validadas.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
