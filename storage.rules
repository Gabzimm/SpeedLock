rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // lib/services/profile_service.dart -> uploadAvatar()
    // Cada um só pode escrever no seu próprio ficheiro (nome = uid.jpg,
    // ver AuthService/ProfileService — nunca é o utilizador a escolher
    // o nome do ficheiro). Leitura é pública de propósito: o URL só é
    // entregue a quem já passou pelo controlo de acesso em
    // `getDeviceMembersProfiles`, mas o ficheiro em si funciona como uma
    // foto de perfil normal — quem tiver o link direto consegue vê-la,
    // tal como a generalidade das apps trata fotos de perfil.
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.firebase.sign_in_provider != 'anonymous'
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
